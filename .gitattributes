# Normalize line endings for every text file in the repository.
# Without this, a Windows checkout rewrites LF to CRLF and every later diff is noisy.
* text=auto eol=lf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary

# Generated or vendored content is excluded from language statistics.
uv.lock linguist-generated=true
*.lock linguist-generated=true
